        print {$turn_file} encode_json($params);
        close $turn_file;
        my $text = $params->{input}[0]{text} // '';
        if ($text eq 'FAIL') {
            emit({ id => $request->{id}, error => { code => -32000, message => 'Fixture turn failed' } });
            next;
        }
        if ($text eq 'START_WAIT') {
            open my $started_file, '>', "$cwd/turn-starting" or die $!;
            close $started_file;
            select undef, undef, undef, 0.5;
        } elsif ($text eq 'APPROVAL') {
